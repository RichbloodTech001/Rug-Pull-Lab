# Server-side database connection. Never commit the real value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rug_pull_lab?schema=public"

# Server-side financial posting control. Keep unset until a controlled platform clearing account exists.
PLATFORM_CLEARING_ACCOUNT_ID=

# Public client-safe Solana configuration. Keep research deployments on Devnet/Localnet.
NEXT_PUBLIC_SOLANA_RPC_URL=
NEXT_PUBLIC_SOLANA_NETWORK=devnet
