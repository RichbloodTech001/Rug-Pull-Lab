generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  SUPPORT
  COMPLIANCE
  FINANCE
  ADMIN
  SUPER_ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum JournalStatus {
  POSTED
  VOIDED
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum CurrencyType {
  FIAT
  CRYPTO
}

enum TransactionKind {
  DEPOSIT
  WITHDRAWAL
  FEE
  ADJUSTMENT
}

enum TransactionStatus {
  PENDING
  PROCESSING
  AWAITING_APPROVAL
  CONFIRMED
  FAILED
  CANCELLED
  REVERSED
}

enum ReconciliationStatus {
  MATCHED
  MISMATCH
  MISSING_COUNTERPARTY
  DUPLICATE
}

enum IncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum IncidentStatus {
  OPEN
  INVESTIGATING
  CONTAINED
  RESOLVED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum ComplianceRiskTier {
  LOW
  MEDIUM
  HIGH
  PROHIBITED
}

enum ScreeningStatus {
  CLEAR
  MATCH
  PENDING
}

model User {
  id String @id @default(cuid())
  email String @unique
  passwordHash String
  role UserRole @default(USER)
  emailVerifiedAt DateTime?
  twoFactorEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts FinancialAccount[]
  auditEvents AuditEvent[]
  transactions PaymentTransaction[]
  incidents Incident[]
  complianceProfile ComplianceProfile?
}

model Session {
  id String @id @default(cuid())
  userId String
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model ComplianceProfile {
  id String @id @default(cuid())
  userId String @unique
  kyc VerificationStatus @default(NOT_STARTED)
  kyb VerificationStatus @default(NOT_STARTED)
  sanctions ScreeningStatus @default(PENDING)
  pep ScreeningStatus @default(PENDING)
  sourceOfFunds VerificationStatus @default(NOT_STARTED)
  riskTier ComplianceRiskTier @default(MEDIUM)
  reviewedAt DateTime?
  reviewedById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([riskTier, updatedAt])
}

model FinancialAccount {
  id String @id @default(cuid())
  userId String
  assetCode String
  assetType CurrencyType
  status AccountStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger LedgerAccount?
  transactions PaymentTransaction[]
  @@unique([userId, assetCode])
  @@index([userId])
}

model LedgerAccount {
  id String @id @default(cuid())
  accountId String @unique
  type LedgerAccountType
  currency String
  createdAt DateTime @default(now())
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries LedgerEntry[]
}

model JournalTransaction {
  id String @id @default(cuid())
  reference String @unique
  description String
  status JournalStatus @default(POSTED)
  idempotencyKey String @unique
  createdAt DateTime @default(now())
  entries LedgerEntry[]
  payment PaymentTransaction?
}

model LedgerEntry {
  id String @id @default(cuid())
  journalId String
  ledgerAccountId String
  direction EntryDirection
  amountMinor BigInt
  currency String
  createdAt DateTime @default(now())
  journal JournalTransaction @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ledgerAccount LedgerAccount @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  @@index([journalId])
  @@index([ledgerAccountId, currency])
}

model PaymentTransaction {
  id String @id @default(cuid())
  userId String
  accountId String
  kind TransactionKind
  status TransactionStatus @default(PENDING)
  amountMinor BigInt
  feeMinor BigInt @default(0)
  currency String
  idempotencyKey String @unique
  externalReference String?
  journalId String? @unique
  failureReason String?
  metadata Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  account FinancialAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)
  journal JournalTransaction? @relation(fields: [journalId], references: [id], onDelete: Restrict)
  fees PaymentFee[]
  @@index([userId, createdAt])
  @@index([accountId, status])
  @@index([externalReference])
}

model PaymentFee {
  id String @id @default(cuid())
  transactionId String
  amountMinor BigInt
  currency String
  code String
  createdAt DateTime @default(now())
  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  @@index([transactionId])
}

model AuditEvent {
  id String @id @default(cuid())
  userId String?
  action String
  target String
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}

model ReconciliationRecord {
  id String @id @default(cuid())
  reference String
  source String
  externalReference String?
  idempotencyKey String @unique
  assetCode String
  amountMinor BigInt
  status ReconciliationStatus @default(MATCHED)
  varianceMinor BigInt @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([reference])
  @@index([externalReference])
}

model Incident {
  id String @id @default(cuid())
  title String
  description String
  severity IncidentSeverity
  status IncidentStatus @default(OPEN)
  ownerId String?
  detectedAt DateTime @default(now())
  resolvedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  owner User? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  events IncidentEvent[]
  @@index([status, severity])
}

model IncidentEvent {
  id String @id @default(cuid())
  incidentId String
  action String
  detail String
  createdAt DateTime @default(now())
  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  @@index([incidentId, createdAt])
}
