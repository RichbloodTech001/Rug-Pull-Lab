generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { USER SUPPORT COMPLIANCE FINANCE ADMIN SUPER_ADMIN }
enum AccountStatus { ACTIVE SUSPENDED CLOSED }
enum LedgerAccountType { ASSET LIABILITY EQUITY REVENUE EXPENSE }
enum JournalStatus { POSTED VOIDED }
enum EntryDirection { DEBIT CREDIT }
enum CurrencyType { FIAT CRYPTO }
enum TransactionKind { DEPOSIT WITHDRAWAL FEE ADJUSTMENT }
enum TransactionStatus { PENDING PROCESSING AWAITING_APPROVAL CONFIRMED FAILED CANCELLED REVERSED }

model User {
  id               String             @id @default(cuid())
  email            String             @unique
  passwordHash     String
  role             UserRole           @default(USER)
  emailVerifiedAt  DateTime?
  twoFactorEnabled Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  accounts         FinancialAccount[]
  auditEvents      AuditEvent[]
  transactions     PaymentTransaction[]
}

model FinancialAccount {
  id        String        @id @default(cuid())
  userId    String
  assetCode String
  assetType CurrencyType
  status    AccountStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  user      User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger    LedgerAccount?
  transactions PaymentTransaction[]
  @@unique([userId, assetCode])
  @@index([userId])
}

model LedgerAccount {
  id        String            @id @default(cuid())
  accountId String            @unique
  type      LedgerAccountType
  currency  String
  createdAt DateTime          @default(now())
  account   FinancialAccount  @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries   LedgerEntry[]
}

model JournalTransaction {
  id             String          @id @default(cuid())
  reference      String          @unique
  description    String
  status         JournalStatus   @default(POSTED)
  idempotencyKey String          @unique
  createdAt      DateTime        @default(now())
  entries        LedgerEntry[]
  payment        PaymentTransaction?
}

model LedgerEntry {
  id              String             @id @default(cuid())
  journalId       String
  ledgerAccountId String
  direction       EntryDirection
  amountMinor     BigInt
  currency        String
  createdAt       DateTime           @default(now())
  journal         JournalTransaction @relation(fields: [journalId], references: [id], onDelete: Restrict)
  ledgerAccount   LedgerAccount      @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  @@index([journalId])
  @@index([ledgerAccountId, currency])
}

model PaymentTransaction {
  id                String             @id @default(cuid())
  userId            String
  accountId         String
  kind              TransactionKind
  status            TransactionStatus @default(PENDING)
  amountMinor       BigInt
  feeMinor          BigInt             @default(0)
  currency          String
  idempotencyKey    String             @unique
  externalReference String?
  journalId         String?            @unique
  failureReason     String?
  metadata          Json?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  account           FinancialAccount   @relation(fields: [accountId], references: [id], onDelete: Restrict)
  journal           JournalTransaction? @relation(fields: [journalId], references: [id], onDelete: Restrict)
  fees              PaymentFee[]
  @@index([userId, createdAt])
  @@index([accountId, status])
  @@index([externalReference])
}

model PaymentFee {
  id            String             @id @default(cuid())
  transactionId String
  amountMinor   BigInt
  currency      String
  code          String
  createdAt     DateTime           @default(now())
  transaction   PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  @@index([transactionId])
}

model AuditEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  target    String
  metadata  Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
}
